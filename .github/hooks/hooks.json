{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "bash": "printf '%s\\n' 'Copilot agent session started'",
        "powershell": "Write-Output 'Copilot agent session started'",
        "cwd": ".",
        "timeoutSec": 5
      }
    ],
    "sessionEnd": [
      {
        "type": "command",
        "bash": "printf '%s\\n' 'Copilot agent session ended'",
        "powershell": "Write-Output 'Copilot agent session ended'",
        "cwd": ".",
        "timeoutSec": 5
      }
    ]
  }
}